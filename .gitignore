# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Hosting deploy cache (regenerated on each `firebase deploy`)
.firebase/

# NDID API docs / Postman collection (internal spec — do not commit)
ndid_doc/

# Mobile API docs with real example data/tokens (do not commit)
api_data/

# Auto-deploy bookkeeping (tools/deploy-uat.sh): a fingerprint of the last
# deployed sources and the last version stamp. Machine-local, not shared.
/.deploy-stamp-uat
/.deploy-version-uat

# Firestore config dumps + the backups the importer takes before writing.
# These hold live API tokens (agent_web_api_token*) — do not commit.
/etc/*.txt
/etc/backup/

# NDID node docs (Postman collection/environment + proxy spec). Same reason as
# ndid_doc/ above: vendor material, and the environment file carries node keys.
/dap/

# Reference copy of the original regmast_ploan.php curl call. Kept locally for
# comparison with services/p_loan_api_service.dart; internal host + not ours.
/p-loan-api-call.php

# Stray compiled-Dart dump (a copy of a build's main.dart.js). Build artifact.
/m.js
