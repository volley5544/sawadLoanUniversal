# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Hosting deploy cache (regenerated on each `firebase deploy`)
.firebase/

# NDID API docs / Postman collection (internal spec — do not commit)
ndid_doc/

# Mobile API docs with real example data/tokens (do not commit)
api_data/

# Auto-deploy bookkeeping (tools/deploy-uat.sh): a fingerprint of the last
# deployed sources and the last version stamp. Machine-local, not shared.
/.deploy-stamp-uat
/.deploy-version-uat

# Working-copy scratch: Firestore config dumps (live agent_web_api_token*),
# API samples with service credentials, BA design PDFs, and screenshots from
# testers — which carry real contract numbers and balances.
#
# ⚠ The whole directory, not just *.txt. The narrower rule let the BA redesign
# PDF and three device screenshots reach the remote in 2026-09-12/13 commits
# while CLAUDE.md said they were ignored. Nothing in here belongs in git.
/etc/

# NDID node docs (Postman collection/environment + proxy spec). Same reason as
# ndid_doc/ above: vendor material, and the environment file carries node keys.
/dap/

# Reference copy of the original regmast_ploan.php curl call. Kept locally for
# comparison with services/p_loan_api_service.dart; internal host + not ours.
/p-loan-api-call.php

# Stray compiled-Dart dump (a copy of a build's main.dart.js). Build artifact.
/m.js

# Pentest findings (2026-08-11) and the vendor requirements PDF. Same rule as
# api_data/ and ndid_doc/ above: a findings report is a map of this system's
# weak points, and the sheet is 43 MB of embedded evidence. Keep both local.
/pentest_doc/
/Digital Lending with Srisawad*.pdf
